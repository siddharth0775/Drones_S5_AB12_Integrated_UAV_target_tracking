<mujoco model="hello">

    <worldbody>

        <!-- Light -->
        <light diffuse=".5 .5 .5"
               pos="0 0 3"
               dir="0 0 -1"/>

        <!-- Ground -->
        <geom type="plane"
              size="5 5 0.1"/>

        <!-- Floating box -->
        <body name="box" pos="0 0 1">

            <freejoint/>

            <geom type="box"
                  size=".2 .2 .2"
                  mass="1"/>

        </body>

    </worldbody>

</mujoco> 