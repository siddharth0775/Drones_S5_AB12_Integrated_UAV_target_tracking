<mujoco model="uav">

    <option gravity="0 0 -9.81"/>

    <worldbody>

        <!-- ================= GROUND ================= -->

        <geom
            name="ground"
            type="plane"
            size="10 10 0.1"
            rgba="0.7 0.7 0.7 1"/>


        <!-- ================= LIGHT ================= -->

        <light
            name="sun"
            pos="0 0 5"
            dir="0 0 -1"
            diffuse="1 1 1"/>


        <!-- ================= UAV ================= -->

        <body name="uav" pos="0 0 2">

            <!-- 6 DOF -->
            <freejoint name="uav_freejoint"/>


            <!-- UAV MAIN BODY -->

            <geom
                name="uav_body"
                type="box"
                size="0.3 0.2 0.08"
                mass="1.0"
                rgba="0.2 0.2 0.2 1"/>


            <!-- ================= CAMERA ================= -->

            <!--
                Camera is attached to the UAV.
                It automatically looks at the target body.
            -->

            <camera
                name="uav_camera"
                pos="0.35 0 0.05"
                quat="-0.5 -0.5 0.5 0.5"
                fovy="70"/>


            <!-- ================= ROTOR 1 ================= -->

            <body name="rotor_1" pos="0.3 0.25 0">

                <geom
                    name="rotor_1_visual"
                    type="cylinder"
                    size="0.12 0.02"
                    mass="0.01"/>

                <site
                    name="thrust_1"
                    pos="0 0 0"
                    size="0.03"/>

            </body>


            <!-- ================= ROTOR 2 ================= -->

            <body name="rotor_2" pos="0.3 -0.25 0">

                <geom
                    name="rotor_2_visual"
                    type="cylinder"
                    size="0.12 0.02"
                    mass="0.01"/>

                <site
                    name="thrust_2"
                    pos="0 0 0"
                    size="0.03"/>

            </body>


            <!-- ================= ROTOR 3 ================= -->

            <body name="rotor_3" pos="-0.3 -0.25 0">

                <geom
                    name="rotor_3_visual"
                    type="cylinder"
                    size="0.12 0.02"
                    mass="0.01"/>

                <site
                    name="thrust_3"
                    pos="0 0 0"
                    size="0.03"/>

            </body>


            <!-- ================= ROTOR 4 ================= -->

            <body name="rotor_4" pos="-0.3 0.25 0">

                <geom
                    name="rotor_4_visual"
                    type="cylinder"
                    size="0.12 0.02"
                    mass="0.01"/>

                <site
                    name="thrust_4"
                    pos="0 0 0"
                    size="0.03"/>

            </body>

        </body>


        <!-- ================= TARGET ================= -->

        <!--
            Red spherical target.
            It is placed in front of the UAV.
        -->

        <body name="target" pos="2 0 2.5">

            <geom
                name="target_visual"
                type="sphere"
                size="0.30"
                rgba="0 1 0 1"
                contype="0"
                conaffinity="0"/>

        </body>

    </worldbody>

</mujoco>